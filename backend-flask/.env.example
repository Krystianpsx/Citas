# Copia este archivo como .env y ajusta los valores (Flask lo lee si tienes python-dotenv).
# Motor de base de datos. Ejemplos:
#   sqlite:///citas_medicas.db
#   postgresql+psycopg://usuario:clave@localhost:5432/citas   (requiere: pip install psycopg[binary])
DATABASE_URL=sqlite:///citas_medicas.db

# "sql" usa DATABASE_URL; "memoria" no guarda nada al reiniciar (útil para demostraciones).
PERSISTENCIA=sql

# Orígenes del frontend autorizados por CORS, separados por coma.
ORIGENES_PERMITIDOS=http://localhost:5173
